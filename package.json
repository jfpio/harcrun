{
  "name": "harcrun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/check-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm --prefix functions run build && node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-harcrun --only firestore 'node --test tests/rules.mjs'",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-harcrun",
    "check": "npm run build && npm test",
    "test:integration": "npm --prefix functions run build && firebase emulators:exec --project demo-harcrun --only auth,firestore,functions \"node --test tests/integration.mjs\"",
    "seed": "node scripts/seed-emulators.mjs",
    "dev:emulators": "VITE_USE_EMULATORS=true vite --host 127.0.0.1",
    "build:production": "node scripts/production-check.mjs && npm run build",
    "format": "prettier --write src shared functions/src tests scripts *.ts *.js *.json public/sw.js",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@zxing/browser": "^0.1.5",
    "firebase": "^12.17.1",
    "lucide-react": "^0.562.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.5.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
